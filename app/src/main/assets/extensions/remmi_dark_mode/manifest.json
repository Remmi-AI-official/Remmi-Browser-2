{
  "manifest_version": 2,
  "name": "Remmi Smart Dark Mode",
  "version": "1.0",
  "description": "Smart forced dark mode with media preservation for Remmi Browser",
  "browser_specific_settings": {
    "gecko": {
      "id": "darkmode@remmi.browser",
      "strict_min_version": "100.0"
    }
  },
  "permissions": [
    "<all_urls>",
    "storage"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["dark.css"],
      "js": ["dark.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
